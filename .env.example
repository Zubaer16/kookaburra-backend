# Local development only. Never commit .env or live credentials.
NODE_ENV=development
PORT=4000
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
SWAGGER_ENABLED=true
# Can leave empty for health/docs-only testing; auth will return 503 without a DB.
# Neon/VPS connection; use a pooled runtime URL in serverless deployments.
DATABASE_URL=
# Use the non-pooler URL for Prisma migrations if your provider requires one.
DIRECT_URL=
# Generate unique random bytes for this installation (32+ chars). Mandatory when DB is configured.
JWT_ACCESS_SECRET=

# Phase 03C: direct Cloudinary signed upload; optional until enabled.
MEDIA_CLOUD_NAME=
MEDIA_API_KEY=
MEDIA_API_SECRET=
MEDIA_NAMESPACE=projects/kookaburra/products

# Phase 03C-2A: choose per installation. Existing rows retain original provider.
# Cloudinary remains the default for backwards compatibility.
MEDIA_PROVIDER=cloudinary
# To switch new uploads to S3/R2, set MEDIA_PROVIDER=s3 and configure all six below.
# AWS example endpoint: https://s3.us-east-1.amazonaws.com; region us-east-1.
# R2 example endpoint: https://<accountid>.r2.cloudflarestorage.com; region auto.
MEDIA_S3_ENDPOINT=
MEDIA_S3_BUCKET=
MEDIA_S3_REGION=
MEDIA_S3_ACCESS_KEY_ID=
MEDIA_S3_SECRET_ACCESS_KEY=
# Public read URL for the bucket (CDN/Cloudflare custom domain or bucket public URL).
# Never use a private API endpoint as the public delivery URL.
MEDIA_S3_PUBLIC_BASE_URL=

# Phase 03C-2B: persistent VPS/Docker only. Not Vercel local disk.
# Existing Cloudinary/S3 media stays on the original stored provider.
# MEDIA_PROVIDER=disk
# Use an absolute path on a mounted, backed-up persistent volume.
MEDIA_DISK_ROOT=
# Bare origin accessible from Admin frontend for signed raw PUT.
MEDIA_DISK_API_BASE_URL=
# Bare origin used for published product image GET (can be CDN reverse proxy to API).
MEDIA_DISK_PUBLIC_BASE_URL=
# A dedicated random 32+ character secret, separate from JWT secrets.
MEDIA_DISK_UPLOAD_SECRET=
