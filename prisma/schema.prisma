// Phase 02: canonical identities, accounts/sessions, skeleton catalog, durable outbox.
// DO NOT import mismatched Storefront/Admin demo fixtures as production truth.
generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  CUSTOMER
  STAFF
  ADMIN
  OWNER
}

enum UserStatus {
  ACTIVE
  DISABLED
}

enum ProductStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum OutboxStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

model User {
  id           String        @id @default(uuid()) @db.Uuid
  email        String        @unique @db.VarChar(320)
  displayName  String        @default("") @map("display_name") @db.VarChar(120)
  passwordHash String        @map("password_hash") @db.Text
  role         UserRole      @default(CUSTOMER)
  status       UserStatus    @default(ACTIVE)
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")
  sessions     AuthSession[]
  auditEvents  AuditEvent[]
  staffRoleAssignment StaffRoleAssignment?
  cart Cart?
  mergedGuestCarts GuestCart[]

  @@map("users")
}

model AuthSession {
  id          String    @id @default(uuid()) @db.Uuid
  userId      String    @map("user_id") @db.Uuid
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  familyId    String    @map("family_id") @db.Uuid
  tokenHash   String    @unique @map("token_hash") @db.VarChar(64)
  expiresAt   DateTime  @map("expires_at")
  revokedAt   DateTime? @map("revoked_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  @@index([userId, familyId])
  @@index([expiresAt])
  @@map("auth_sessions")
}

model AuditEvent {
  id          String   @id @default(uuid()) @db.Uuid
  actorId     String?  @map("actor_id") @db.Uuid
  actor       User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  action      String   @db.VarChar(120)
  targetType  String   @map("target_type") @db.VarChar(80)
  targetId    String?  @map("target_id") @db.VarChar(128)
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([createdAt])
  @@map("audit_events")
}

model Category {
  id          String       @id @default(uuid()) @db.Uuid
  slug        String       @unique @db.VarChar(160)
  name        String       @db.VarChar(200)
  description String       @default("") @db.Text
  // Frontend navigation metadata; active hides category from navigation, not products.
  color       String       @default("#EAF0FF") @db.VarChar(7)
  sortOrder   Int          @default(0) @map("sort_order")
  active      Boolean      @default(true)
  parentId    String?      @map("parent_id") @db.Uuid
  parent      Category?    @relation("CategoryTree", fields: [parentId], references: [id], onDelete: Restrict)
  children    Category[]   @relation("CategoryTree")
  products    ProductCategory[]
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")

  @@index([parentId])
  @@map("categories")
}

model Product {
  id             String         @id @default(uuid()) @db.Uuid
  slug           String         @unique @db.VarChar(200)
  title          String         @db.VarChar(250)
  sku            String?        @unique @db.VarChar(120)
  description    String         @default("") @db.Text
  badge          String         @default("") @db.VarChar(80)
  tag            String?        @db.VarChar(16)
  status         ProductStatus  @default(DRAFT)
  currency       String         @default("USD") @db.VarChar(3)
  priceMinor     Int            @map("price_minor")
  compareAtMinor Int?           @map("compare_at_minor")
  // Simple product: stockOnHand is authoritative. With variants: variant stock is.
  hasVariants    Boolean        @default(false) @map("has_variants")
  stockOnHand    Int            @default(0) @map("stock_on_hand")
  variants       ProductVariant[]
  inventoryBalance InventoryBalance?
  categories     ProductCategory[]
  media          ProductMedia[]
  cartItems     CartItem[]
  guestCartItems GuestCartItem[]
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")

  @@index([status])
  @@map("products")
}

model ProductVariant {
  id          String   @id @default(uuid()) @db.Uuid
  productId   String   @map("product_id") @db.Uuid
  product     Product  @relation(fields: [productId], references: [id], onDelete: Restrict)
  sku         String   @unique @db.VarChar(120)
  options     Json     @default("{}")
  priceMinor  Int?     @map("price_minor")
  stockOnHand Int      @default(0) @map("stock_on_hand")
  inventoryBalance InventoryBalance?
  cartItems   CartItem[]
  guestCartItems GuestCartItem[]
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([productId])
  @@map("product_variants")
}

model ProductCategory {
  productId  String   @map("product_id") @db.Uuid
  categoryId String   @map("category_id") @db.Uuid
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([productId, categoryId])
  @@map("product_categories")
}

enum InventoryReason {
  OPENING
  RECEIPT
  RETURN
  DAMAGE
  CORRECTION
}

// Exactly one of productId/variantId is populated (also checked by SQL).
// The existing Catalog stockOnHand fields remain backward-compatible mirrors;
// all post-creation writes must go through the Inventory service.
model InventoryBalance {
  id                String             @id @default(uuid()) @db.Uuid
  productId         String?            @unique @map("product_id") @db.Uuid
  variantId         String?            @unique @map("variant_id") @db.Uuid
  product           Product?           @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant           ProductVariant?    @relation(fields: [variantId], references: [id], onDelete: Cascade)
  onHand            Int                @default(0) @map("on_hand")
  lowStockThreshold Int                @default(5) @map("low_stock_threshold")
  movements         InventoryMovement[]
  createdAt         DateTime           @default(now()) @map("created_at")
  updatedAt         DateTime           @updatedAt @map("updated_at")

  @@map("inventory_balances")
}

// Append-only through the HTTP API. requestId is unique per inventory item
// to make retries safe even if the HTTP caller loses the first response.
model InventoryMovement {
  id         String          @id @default(uuid()) @db.Uuid
  balanceId  String          @map("balance_id") @db.Uuid
  balance    InventoryBalance @relation(fields: [balanceId], references: [id], onDelete: Cascade)
  requestId  String          @map("request_id") @db.Uuid
  reason     InventoryReason
  delta      Int
  before     Int
  after      Int
  note       String          @default("") @db.VarChar(500)
  actorId    String?         @map("actor_id") @db.Uuid
  createdAt  DateTime        @default(now()) @map("created_at")

  @@unique([balanceId, requestId])
  @@index([balanceId, createdAt])
  @@map("inventory_movements")
}

model OutboxEvent {
  id          String       @id @default(uuid()) @db.Uuid
  eventType   String       @map("event_type") @db.VarChar(150)
  payload     Json
  status      OutboxStatus @default(PENDING)
  attempts    Int          @default(0)
  availableAt DateTime     @default(now()) @map("available_at")
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")

  @@index([status, availableAt])
  @@map("outbox_events")
}

model IdempotencyRecord {
  id          String   @id @default(uuid()) @db.Uuid
  scope       String   @db.VarChar(120)
  key         String   @db.VarChar(200)
  requestHash String   @map("request_hash") @db.VarChar(64)
  response    Json?
  expiresAt   DateTime @map("expires_at")
  createdAt   DateTime @default(now()) @map("created_at")

  @@unique([scope, key])
  @@index([expiresAt])
  @@map("idempotency_records")
}

// A1: one persisted Admin workspace role per staff member, five seeded roles.
// Role -> permission decisions are always made server-side, never from JWT claims.
model StaffRole {
  key         String                @id @db.VarChar(40)
  displayName String                @map("display_name") @db.VarChar(80)
  permissions StaffRolePermission[]
  assignments StaffRoleAssignment[]

  @@map("staff_roles")
}
model StaffRolePermission {
  roleKey       String    @map("role_key") @db.VarChar(40)
  permissionKey String    @map("permission_key") @db.VarChar(80)
  role          StaffRole @relation(fields: [roleKey], references: [key], onDelete: Restrict)

  @@id([roleKey, permissionKey])
  @@map("staff_role_permissions")
}
model StaffRoleAssignment {
  userId     String    @id @map("user_id") @db.Uuid
  roleKey    String    @map("role_key") @db.VarChar(40)
  assignedAt DateTime  @default(now()) @map("assigned_at")
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  role       StaffRole @relation(fields: [roleKey], references: [key], onDelete: Restrict)

  @@index([roleKey])
  @@map("staff_role_assignments")
}

// Phase 03C: media metadata, non-public provider identities and shared references.
enum MediaAssetStatus {
  PENDING_UPLOAD
  ACTIVE
  PENDING_DELETE
  DELETED
  DELETE_FAILED
}

enum MediaDeletionStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  CANCELLED
}

model MediaAsset {
  id                 String            @id @default(uuid()) @db.Uuid
  provider           String            @db.VarChar(40)
  namespace          String            @db.VarChar(160)
  objectKey          String            @unique @map("object_key") @db.VarChar(500)
  providerAssetId    String?           @map("provider_asset_id") @db.VarChar(200)
  mimeType           String            @map("mime_type") @db.VarChar(80)
  bytes              Int               @default(0)
  width              Int               @default(0)
  height             Int               @default(0)
  publicUrl          String?           @map("public_url") @db.Text
  renditions         Json?             @db.JsonB // Phase 03C-2C2: READY widths only
  status             MediaAssetStatus  @default(PENDING_UPLOAD)
  uploadExpiresAt    DateTime          @map("upload_expires_at")
  createdAt          DateTime          @default(now()) @map("created_at")
  updatedAt          DateTime          @updatedAt @map("updated_at")
  productLinks       ProductMedia[]
  deletionJob        MediaDeletionJob?

  @@index([status, uploadExpiresAt])
  @@map("media_assets")
}

model ProductMedia {
  productId String      @map("product_id") @db.Uuid
  mediaId   String      @map("media_id") @db.Uuid
  position  Int         @default(0)
  altText   String      @default("") @map("alt_text") @db.VarChar(250)
  product   Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  media     MediaAsset  @relation(fields: [mediaId], references: [id], onDelete: Restrict)

  @@id([productId, mediaId])
  @@index([mediaId])
  @@map("product_media")
}

model MediaDeletionJob {
  id          String              @id @default(uuid()) @db.Uuid
  mediaId     String              @unique @map("media_id") @db.Uuid
  media       MediaAsset          @relation(fields: [mediaId], references: [id], onDelete: Cascade)
  status      MediaDeletionStatus @default(PENDING)
  attempts    Int                 @default(0)
  availableAt DateTime            @map("available_at")
  claimedAt   DateTime?           @map("claimed_at")
  lastError   String?             @map("last_error") @db.VarChar(250)
  createdAt   DateTime            @default(now()) @map("created_at")
  updatedAt   DateTime            @updatedAt @map("updated_at")

  @@index([status, availableAt])
  @@map("media_deletion_jobs")
}

// Phase 04A-1: customer-owned, persistent cart. A cart is not a stock hold.
// Guest ownership, address, taxes, delivery and order creation arrive later.
model Cart {
  id        String     @id @default(uuid()) @db.Uuid
  userId    String     @unique @map("user_id") @db.Uuid
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     CartItem[]
  createdAt DateTime   @default(now()) @map("created_at")
  updatedAt DateTime   @updatedAt @map("updated_at")

  @@map("carts")
}

model CartItem {
  id        String          @id @default(uuid()) @db.Uuid
  cartId    String          @map("cart_id") @db.Uuid
  cart      Cart            @relation(fields: [cartId], references: [id], onDelete: Cascade)
  productId String          @map("product_id") @db.Uuid
  product   Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variantId String?         @map("variant_id") @db.Uuid
  variant   ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Cascade)
  quantity  Int
  createdAt DateTime        @default(now()) @map("created_at")
  updatedAt DateTime        @updatedAt @map("updated_at")

  // For variant lines; SQL adds separate partial unique index for simple products.
  @@unique([cartId, productId, variantId], map: "cart_items_cart_product_variant_key")
  @@index([productId])
  @@index([variantId])
  @@map("cart_items")
}

// Anonymous cart capability: token is returned ONCE, only its SHA-256 hash is stored.
// Guest ownership is never inferred from email, IP, User-Agent, or browser cookies.
model GuestCart {
  id           String    @id @default(uuid()) @db.Uuid
  tokenHash    String    @unique @map("token_hash") @db.VarChar(64)
  expiresAt    DateTime  @map("expires_at")
  mergedUserId String?   @map("merged_user_id") @db.Uuid
  mergedUser   User?     @relation(fields: [mergedUserId], references: [id], onDelete: SetNull)
  mergedAt     DateTime? @map("merged_at")
  items        GuestCartItem[]
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  @@index([expiresAt])
  @@map("guest_carts")
}

model GuestCartItem {
  id          String          @id @default(uuid()) @db.Uuid
  guestCartId String          @map("guest_cart_id") @db.Uuid
  guestCart   GuestCart       @relation(fields: [guestCartId], references: [id], onDelete: Cascade)
  productId   String          @map("product_id") @db.Uuid
  product     Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variantId   String?         @map("variant_id") @db.Uuid
  variant     ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Cascade)
  quantity    Int
  createdAt   DateTime        @default(now()) @map("created_at")
  updatedAt   DateTime        @updatedAt @map("updated_at")

  @@unique([guestCartId, productId, variantId], map: "guest_cart_items_line_key")
  @@index([productId])
  @@index([variantId])
  @@map("guest_cart_items")
}

// 04B-1: Explicit, owner-maintained country/currency checkout estimate policy.
// No default jurisdiction, no implicit free shipping, no stock hold or order.
model CheckoutRate {
  id                     String   @id @default(uuid()) @db.Uuid
  countryCode            String   @map("country_code") @db.VarChar(2)
  currency               String   @db.VarChar(3)
  shippingMinor          Int      @map("shipping_minor")
  freeOverSubtotalMinor  Int?     @map("free_over_subtotal_minor")
  taxBps                 Int      @map("tax_bps")
  enabled                Boolean  @default(true)
  createdAt              DateTime @default(now()) @map("created_at")
  updatedAt              DateTime @updatedAt @map("updated_at")

  @@unique([countryCode, currency], map: "checkout_rates_country_currency_key")
  @@map("checkout_rates")
}
